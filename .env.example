# Copy to .env in the repository root (never commit .env). The backend reads it automatically;
# real environment variables override it. See docs/configuration.md for every setting.

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/nutritrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=nutritrack
DB_PASSWORD=change-me

# --- JWT ---
# Base64-encoded secret of at least 256 bits. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Access token lifetime in minutes, refresh token lifetime in days
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- External food data providers (optional) ---
# USDA FoodData Central API key, free from https://fdc.nal.usda.gov/api-key-signup
# Leave empty to disable the USDA provider; the app still works with seeded foods.
USDA_FDC_API_KEY=
USDA_FDC_ENABLED=false
# Open Food Facts needs no key, but asks for a descriptive User-Agent with contact info.
OPENFOODFACTS_ENABLED=false
OPENFOODFACTS_USER_AGENT=NutriTrack/1.0 (your-email@example.com)

# --- Refresh cookie ---
# Set COOKIE_SECURE=true whenever the app is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# --- Frontend (Vite) ---
# Vite reads its own variables from frontend/.env*, not from this file.
# In development leave VITE_API_BASE_URL empty: the dev server proxies /api to the backend
# (set VITE_DEV_API_PROXY in your shell to change the target, default http://localhost:8080),
# so the refresh cookie stays same-origin.
# VITE_API_BASE_URL=


# --- Docker setup (docker compose / setup scripts) ---
# Port for the web app; the setup scripts generate the database passwords and JWT secret.
APP_PORT=3000
MYSQL_ROOT_PASSWORD=
